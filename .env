# ============================================
# LLM Provider Configuration
# ============================================
# Supported: ollama | vllm | openai | openrouter
# openrouter 使用 OpenAI 兼容 API，本质上和 openai/vllm 相同
LLM_PROVIDER=openrouter

# 模型名称
# OpenRouter 格式: provider/model-name
# 示例: openai/gpt-4o, anthropic/claude-3.5-sonnet, deepseek/deepseek-chat
# 完整列表: https://openrouter.ai/models
LLM_MODEL=

# API Base URL（OpenRouter 必填）
LLM_BASE_URL=https://openrouter.ai/api/v1

# API Key（OpenRouter 必填）
# 从 https://openrouter.ai/keys 获取
OPENAI_API_KEY=

# ============================================
# Optional: OpenRouter 额外请求头
# ============================================
# 如需指定 site URL / app name 用于 OpenRouter 排名统计:
# OPENROUTER_HTTP_REFERER=https://your-site-url.com
# OPENROUTER_APP_NAME=MathAgent
