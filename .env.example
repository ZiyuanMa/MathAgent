# LLM Provider: ollama | vllm | openai
LLM_PROVIDER=ollama

# Model name (e.g., qwen2.5:14b, deepseek-r1:14b, gpt-4o)
LLM_MODEL=qwen2.5:14b

# Base URL for Ollama or vLLM (optional)
# Ollama default: http://localhost:11434
# vLLM default: http://localhost:8000/v1
LLM_BASE_URL=

# API key for OpenAI or vLLM (if required)
OPENAI_API_KEY=sk-no-key-required
